# ==========================================
# SixOrbit TallyPrime Local Connector Config
# ==========================================

# 1. Cloud ERP Connection
ERP_API_BASE_URL=https://your-deployed-erp-app.com
TALLY_BRIDGE_API_KEY=tally-bridge-secret-key-2026

# 2. Local TallyPrime Configuration
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_PROTOCOL=http
TALLY_COMPANY_NAME=Your Tally Company Name

# 3. Polling Configuration
POLL_INTERVAL_SECONDS=15
BATCH_SIZE=10
WORKER_ID=win-tally-node-1
LOG_LEVEL=info
