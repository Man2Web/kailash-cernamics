# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real secrets stay out of Git; the .env.example template is intentionally tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# tally connector build output
/tally-connector/dist/

# local tooling / agent config (not part of the app)
/.claude/
/.agents/
/.windsurf/
skills-lock.json

# database dumps and migration backups must never be committed
*.dump
*.backup
supabase-backup/

# legacy Supabase demo seed (contains a default demo password) - keep local, never commit
/seed.sql
