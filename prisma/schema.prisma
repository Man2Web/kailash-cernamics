  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  amountPaise BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@map("receipt_allocation")
}

model Payment {
  id               String              @id @default(uuid())
  branchId         String
  number           String
  date             DateTime
  partyId          String
  party            Party               @relation(fields: [partyId], references: [id])
  mode             PaymentMode
  reference        String?
  amountPaise      BigInt
  status           DocStatus           @default(POSTED)
  notes            String?
  tallyVoucherGuid String?
  syncStatus       TallySyncState      @default(NOT_QUEUED)
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  @@map("payment")
}

model PaymentAllocation {
  id                String          @id @default(uuid())
  paymentId         String
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  amountPaise       BigInt
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@map("payment_allocation")
}

model LedgerBalanceSnapshot {
  id           String   @id @default(uuid())
  partyId      String
  party        Party    @relation(fields: [partyId], references: [id])
  closingPaise BigInt
  asOf         DateTime
  source       String   @default("TALLY")
  createdAt    DateTime @default(now())

  @@index([partyId, asOf])
  @@map("ledger_balance_snapshot")
}

// ---------------------------------------------------------------- approvals

model ApprovalRequest {
  id            String         @id @default(uuid())
  branchId      String?
  type          ApprovalType
  refType       String
  refId         String
  requestedById String
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  status        ApprovalStatus @default(PENDING)
  reason        String
  decisionNote  String?
  payload       Json?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?

  @@index([status, type])
  @@index([refType, refId])
  @@map("approval_request")
}

// ---------------------------------------------------------------- tally

model TallySyncQueue {
  id            String        @id @default(uuid())
  branchId      String?
  entityType    String
  entityId      String
  direction     SyncDirection @default(TO_TALLY)
  /// lower runs first: masters 10, vouchers 50
  priority      Int           @default(50)
  payloadXml    String?
  status        SyncStatus    @default(PENDING)
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  lastError     String?
  agentId       String?
  tallyGuid     String?
  rawResponse   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?

  @@index([status, nextAttemptAt, priority])
  @@index([entityType, entityId])
  @@map("tally_sync_queue")
}

model TallyAgent {
  id           String    @id @default(uuid())
  branchId     String
  name         String
  apiKeyHash   String    @unique
  apiKeyPrefix String
  lastSeenAt   DateTime?
  lastAlterId  BigInt    @default(0)
  tallyVersion String?
  companyName  String?
  tallyRunning Boolean?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@map("tally_agent")
}

model TallyMapping {
  id        String    @id @default(uuid())
  erpEntity String
  erpId     String
  tallyGuid String
  tallyName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([erpEntity, erpId])
  @@index([tallyGuid])
  @@map("tally_mapping")
}

// ---------------------------------------------------------------- system

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  branchId  String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model NumberSeries {
  id        String    @id @default(uuid())
  branchId  String
  docType   String
  fy        String
  prefix    String
  nextNo    Int       @default(1)
  padding   Int       @default(4)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([branchId, docType, fy])
  @@map("number_series")
}

model Setting {
  id        String    @id @default(uuid())
  key       String    @unique
  value     Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@map("setting")
}

model Attachment {
  id        String    @id @default(uuid())
  entity    String
  entityId  String?
  url       String
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([entity, entityId])
  @@map("attachment")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@index([userId, readAt])
  @@map("notification")
}

model IdempotencyKey {
  id         String   @id @default(uuid())
  /// user id, agent id or "anon"
  scope      String
  key        String
  method     String
  path       String
  statusCode Int
  response   Json?
  createdAt  DateTime @default(now())

  @@unique([scope, key])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------- industry inventory

/// Physical stock count of a godown (optionally one rack / brand); variances post through approval.
model StockCount {
  id         String           @id @default(uuid())
  branchId   String
  number     String
  date       DateTime
  godownId   String
  godown     Godown           @relation(fields: [godownId], references: [id])
  rackId     String?
  brandId    String?
  categoryId String?
  status     CountStatus      @default(DRAFT)
  /// counts are blind: system qty hidden from counters until submitted
  blind      Boolean          @default(true)
  approvalId String?
  notes      String?
  lines      StockCountLine[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?

  @@map("stock_count")
}

model StockCountLine {
  id          String     @id @default(uuid())
  countId     String
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  batchId     String
  batch       Batch      @relation(fields: [batchId], references: [id])
  rackId      String?
  stockType   StockType  @default(SALEABLE)
  systemPcs   Int
  countedPcs  Int?
  variancePcs Int        @default(0)
  countedById String?
  countedAt   DateTime?
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@map("stock_count_line")
}

/// Sample pieces issued to a customer/architect/lead; returned, kept (written off) or billed.
model SampleIssue {
  id                 String            @id @default(uuid())
  branchId           String
  number             String
  date               DateTime
  godownId           String
  godown             Godown            @relation(fields: [godownId], references: [id])
  partyId            String?
  party              Party?            @relation(fields: [partyId], references: [id])
  influencerId       String?
  influencer         Influencer?       @relation(fields: [influencerId], references: [id])
  leadId             String?
  issuedToName       String
  phone              String?
  expectedReturnDate DateTime?
  status             SampleStatus      @default(OPEN)
  notes              String?
  lines              SampleIssueLine[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  @@map("sample_issue")
}

model SampleIssueLine {
  id          String      @id @default(uuid())
  issueId     String
  issue       SampleIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  batchId     String
  batch       Batch       @relation(fields: [batchId], references: [id])
  qtyPcs      Int
  returnedPcs Int         @default(0)
  /// kept by the customer / lost / broken: written off from SAMPLE stock
  closedPcs   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@map("sample_issue_line")
}

/// Showroom display board / bay: which tiles are fixed on it (backed by DISPLAY stock).
model DisplayBoard {
  id        String             @id @default(uuid())
  branchId  String
  godownId  String
  godown    Godown             @relation(fields: [godownId], references: [id])
  code      String
  name      String
  location  String?
  isActive  Boolean            @default(true)
  items     DisplayBoardItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([branchId, code])
  @@map("display_board")
}

model DisplayBoardItem {
  id          String       @id @default(uuid())
  boardId     String
  board       DisplayBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  batchId     String
  batch       Batch        @relation(fields: [batchId], references: [id])
  qtyPcs      Int
  installedAt DateTime     @default(now())
  removedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@map("display_board_item")
}

/// Breakage claimed against the supplier/manufacturer (receipt or transit breakage).
model BreakageClaim {
  id             String          @id @default(uuid())
  branchId       String
  number         String
  date           DateTime
  supplierId     String
  supplier       Party           @relation(fields: [supplierId], references: [id])
  brandId        String?
  status         ClaimStatus     @default(DRAFT)
  claimedPaise   BigInt          @default(0)
  settledPaise   BigInt          @default(0)
  /// CREDIT_NOTE | REPLACEMENT | REJECTED
  settlementType String?
  settlementRef  String?
  settledAt      DateTime?
  notes          String?
  entries        BreakageEntry[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@map("breakage_claim")
}

// ---------------------------------------------------------------- office: employees & attendance

model Employee {
  id          String             @id @default(uuid())
  employeeNo  String             @unique
  name        String
  email       String?            @unique
  phone       String?
  department  String?
  jobTitle    String?
  /// ACTIVE | INACTIVE | SUSPENDED | TERMINATED
  status      String             @default("ACTIVE")
  joiningDate DateTime           @default(now())
  branchId    String?
  branch      Branch?            @relation(fields: [branchId], references: [id])
  /// The login this employee uses to mark their own attendance.
  userId      String?            @unique
  user        User?              @relation(fields: [userId], references: [id])
  attendance  AttendanceRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([branchId])
  @@map("employee")
}

model AttendanceRecord {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  /// Calendar date in India time (YYYY-MM-DD). One record per employee per day.
  attendanceDate   String
  checkInAt        DateTime?
  checkOutAt       DateTime?
  workingMinutes   Int       @default(0)
  /// PRESENT | LATE | HALF_DAY | ABSENT | LEAVE
  status           String    @default("PRESENT")
  /// QR | ADMIN
  method           String    @default("QR")
  correctionReason String?
  branchId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_record")
}
