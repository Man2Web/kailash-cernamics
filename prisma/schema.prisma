model ApprovalWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  docType     String   @unique @map("doc_type") // INVOICE, TRANSFER, REQUISITION, EXPENSE
  name        String
  isActive    Boolean  @default(true) @map("is_active")

  steps       ApprovalWorkflowStep[]
  requests    ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  stepNumber  Int      @map("step_number")
  roleName    String   @map("role_name") // Role expected to approve (e.g. Sales Manager)

  workflow    ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepNumber])
  @@map("approval_workflow_steps")
}

model ApprovalRequest {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  docId       String   @map("doc_id") @db.Uuid // UUID of Invoice, StockTransfer, etc.
  currentStep Int      @default(1) @map("current_step")
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now()) @map("created_at")

  workflow    ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  histories   ApprovalHistory[]

  @@map("approval_requests")
}

model ApprovalHistory {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  stepNumber  Int      @map("step_number")
  userId      String   @map("user_id") @db.Uuid
  action      String   // APPROVED, REJECTED
  comments    String?
  createdAt   DateTime @default(now()) @map("created_at")

  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id])

  @@map("approval_history")
}

