// Kailash Ceramics ERP — data model (docs/specs/schema.md).
// Money = BigInt paise. Tile quantities = Int pieces. Stock changes only through stock_ledger
// (balances in stock_balance are maintained by the ledger service in the same transaction).
// COMMON = createdAt, updatedAt, createdBy, updatedBy, deletedAt (soft delete).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum CategoryType {
  TILE
  SANITARY
  CP_FITTING
  ACCESSORY
  ADHESIVE
}

enum UomType {
  PIECE_BOX_AREA
  UNIT
}

enum Grade {
  PREMIUM
  STANDARD
  COMMERCIAL
}

enum StockType {
  SALEABLE
  DISPLAY
  DAMAGED
  RESERVED
  /// inter-branch transfer dispatched, not yet received (held at the destination godown)
  IN_TRANSIT
  /// sample pieces out on loan to customers/architects (held at the issuing godown)
  SAMPLE
}

enum TransitState {
  IN_TRANSIT
  RECEIVED
}

enum SampleStatus {
  OPEN
  PARTIAL
  CLOSED
}

enum CountStatus {
  DRAFT
  COUNTING
  PENDING_APPROVAL
  POSTED
  CANCELLED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  SETTLED
  REJECTED
}

enum Segment {
  RETAIL
  CONTRACTOR
  DEALER
  BUILDER
  INSTITUTION
  CLEARANCE
}

enum PriceBasis {
  PER_SQFT
  PER_BOX
  PER_UNIT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum InfluencerType {
  ARCHITECT
  INTERIOR
  PLUMBER
  MASON
}

enum BreakageStage {
  RECEIPT
  GODOWN
  TRANSIT
  CUSTOMER
}

enum DocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIAL
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  DISCOUNT
  CREDIT
  ADJUSTMENT
  WRITE_OFF
}

enum AreaType {
  FLOOR
  WALL
  SKIRTING
  HIGHLIGHTER
}

enum PaymentMode {
  CASH
  UPI
  CHEQUE
  NEFT
  CARD
}

enum ChequeStatus {
  PENDING
  DEPOSITED
  CLEARED
  BOUNCED
}

enum SyncDirection {
  TO_TALLY
  FROM_TALLY
}

enum SyncStatus {
  PENDING
  SENT
  SUCCESS
  FAILED
}

enum TallySyncState {
  NOT_QUEUED
  PENDING
  SYNCED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum AllocationBasis {
  VALUE
  WEIGHT
}

enum SchemeTargetType {
  VALUE
  SQFT
}

// ---------------------------------------------------------------- org

model Company {
  id        String    @id @default(uuid())
  name      String
  legalName String?
  gstin     String?
  pan       String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  branches  Branch[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@map("company")
}

model Branch {
  id               String       @id @default(uuid())
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  code             String       @unique
  name             String
  address          String?
  city             String?
  state            String?
  stateCode        String
  gstin            String?
  phone            String?
  tallyCompanyName String?
  isActive         Boolean      @default(true)
  godowns          Godown[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  userBranches     UserBranch[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  invoices         Invoice[]
  employees        Employee[]

  @@map("branch")
}

model Godown {
  id               String            @id @default(uuid())
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id])
  code             String
  name             String
  isDisplay        Boolean           @default(false)
  isActive         Boolean           @default(true)
  racks            Rack[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  stockLedgers     StockLedger[]
  stockBalances    StockBalance[]
  stockAdjustments StockAdjustment[]
  breakageEntries  BreakageEntry[]
  grns             Grn[]
  stockCounts      StockCount[]
  sampleIssues     SampleIssue[]
  displayBoards    DisplayBoard[]

  @@unique([branchId, code])
  @@map("godown")
}

model Rack {
  id            String         @id @default(uuid())
  godownId      String
  godown        Godown         @relation(fields: [godownId], references: [id])
  code          String
  name          String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  stockLedgers  StockLedger[]
  stockBalances StockBalance[]

  @@unique([godownId, code])
  @@map("rack")
}

// ---------------------------------------------------------------- users

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  name               String
  phone              String?
  passwordHash       String
  roleId             String
  role               Role              @relation(fields: [roleId], references: [id])
  isActive           Boolean           @default(true)
  totpSecret         String?
  totpEnabled        Boolean           @default(false)
  /// When true, this person gets exactly customPermissions instead of their role's permissions (set by the Super Admin only).
  useCustomAccess    Boolean           @default(false)
  customPermissions  String[]          @default([])
  defaultBranchId    String?
  lastLoginAt        DateTime?
  branches           UserBranch[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  refreshTokens      RefreshToken[]
  leads              Lead[]
  employee           Employee?

  @@map("user")
}

model Role {
  id               String           @id @default(uuid())
  code             String           @unique
  name             String
  discountLimitPct Float            @default(0)
  isSystem         Boolean          @default(false)
  permissions      RolePermission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  users            User[]

  @@map("role")
}

model Permission {
  id     String           @id @default(uuid())
  code   String           @unique
  module String
  label  String
  roles  RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([familyId])
  @@map("refresh_token")
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_event")
}

// ---------------------------------------------------------------- masters

model Brand {
  id           String    @id @default(uuid())
  name         String    @unique
  code         String?
  isActive     Boolean   @default(true)
  /// preferred supplier/distributor for reorder suggestions
  supplierId   String?
  /// days from PO to GRN, used for reorder suggestions
  leadTimeDays Int       @default(15)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  series       Series[]
  products     Product[]
  schemes      Scheme[]

  @@map("brand")
}

model Category {
  id        String       @id @default(uuid())
  name      String       @unique
  type      CategoryType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  products  Product[]

  @@map("category")
}

model Series {
  id        String    @id @default(uuid())
  name      String
  brandId   String?
  brand     Brand?    @relation(fields: [brandId], references: [id])
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  products  Product[]

  @@map("series")
}

model Size {
  id          String    @id @default(uuid())
  name        String    @unique
  lengthMm    Int
  widthMm     Int
  thicknessMm Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  products    Product[]

  @@map("size")
}

model Finish {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  products  Product[]

  @@map("finish")
}

model Color {
  id              String           @id @default(uuid())
  name            String           @unique
  hex             String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  products        Product[]
  productVariants ProductVariant[]

  @@map("color")
}

// ---------------------------------------------------------------- product

model Product {
  id                   String                @id @default(uuid())
  sku                  String                @unique
  name                 String
  brandId              String
  brand                Brand                 @relation(fields: [brandId], references: [id])
  categoryId           String
  category             Category              @relation(fields: [categoryId], references: [id])
  seriesId             String?
  series               Series?               @relation(fields: [seriesId], references: [id])
  sizeId               String?
  size                 Size?                 @relation(fields: [sizeId], references: [id])
  finishId             String?
  finish               Finish?               @relation(fields: [finishId], references: [id])
  colorId              String?
  color                Color?                @relation(fields: [colorId], references: [id])
  hsn                  String
  gstRate              Float
  uomType              UomType
  unitName             String                @default("nos")
  pcsPerBox            Int?
  sqftPerBox           Float?
  sqmPerBox            Float?
  weightPerBoxKg       Float?
  /// per box for tiles, per unit for sanitary
  mrpPaise             BigInt                @default(0)
  allowLooseSale       Boolean               @default(false)
  reorderLevelPcs      Int                   @default(0)
  /// where the tile is used: FLOOR, WALL, PARKING, ELEVATION, KITCHEN, BATHROOM, OUTDOOR, STEP
  applications         String[]
  /// overrides brand lead time when set
  leadTimeDays         Int?
  /// extra cover kept above lead-time demand (reorder suggestions)
  safetyStockDays      Int                   @default(7)
  images               String[]
  description          String?
  isActive             Boolean               @default(true)
  tallyStockItemGuid   String?
  variants             ProductVariant[]
  batches              Batch[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  priceListItems       PriceListItem[]
  stockLedgers         StockLedger[]
  stockBalances        StockBalance[]
  stockTransferLines   StockTransferLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  breakageEntries      BreakageEntry[]
  quotationLines       QuotationLine[]
  salesOrderLines      SalesOrderLine[]
  invoiceLines         InvoiceLine[]
  challanLines         ChallanLine[]
  salesReturnLines     SalesReturnLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  grnLines             GrnLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  debitNoteLines       DebitNoteLine[]
  stockCountLines      StockCountLine[]
  sampleIssueLines     SampleIssueLine[]
  displayBoardItems    DisplayBoardItem[]

  @@index([name])
  @@map("product")
}

model ProductVariant {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  colorId   String?
  color     Color?    @relation(fields: [colorId], references: [id])
  skuSuffix String
  name      String?
  mrpPaise  BigInt?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  batches   Batch[]

  @@unique([productId, skuSuffix])
  @@map("product_variant")
}

model PriceList {
  id        String          @id @default(uuid())
  name      String
  segment   Segment
  isActive  Boolean         @default(true)
  items     PriceListItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@map("price_list")
}

model PriceListItem {
  id          String     @id @default(uuid())
  priceListId String
  priceList   PriceList  @relation(fields: [priceListId], references: [id])
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  priceBasis  PriceBasis
  pricePaise  BigInt
  validFrom   DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([priceListId, productId, validFrom])
  @@map("price_list_item")
}

// ---------------------------------------------------------------- batch & stock

model Batch {
  id                   String                @id @default(uuid())
  productId            String
  product              Product               @relation(fields: [productId], references: [id])
  batchNo              String
  shadeCode            String
  caliber              String
  grade                Grade                 @default(STANDARD)
  mfgDate              DateTime?
  /// per piece
  purchaseRatePaise    BigInt                @default(0)
  /// per piece, purchase rate + allocated freight/unloading/other charges
  landedCostPaise      BigInt                @default(0)
  supplierId           String?
  grnId                String?
  /// sanitary/CP colour variant stocked as its own lot
  variantId            String?
  variant              ProductVariant?       @relation(fields: [variantId], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  stockLedgers         StockLedger[]
  stockBalances        StockBalance[]
  stockTransferLines   StockTransferLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  breakageEntries      BreakageEntry[]
  salesOrderLines      SalesOrderLine[]
  invoiceLines         InvoiceLine[]
  challanLines         ChallanLine[]
  salesReturnLines     SalesReturnLine[]
  grnLines             GrnLine[]
  stockCountLines      StockCountLine[]
  sampleIssueLines     SampleIssueLine[]
  displayBoardItems    DisplayBoardItem[]

  @@unique([productId, batchNo])
  @@map("batch")
}

model StockLedger {
  id        String    @id @default(uuid())
  branchId  String
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id])
  godownId  String
  godown    Godown    @relation(fields: [godownId], references: [id])
  rackId    String?
  rack      Rack?     @relation(fields: [rackId], references: [id])
  qtyPcs    Int
  stockType StockType
  refType   String
  refId     String
  refLineId String?
  ratePaise BigInt    @default(0)
  note      String?
  postedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([productId, batchId, godownId])
  @@index([refType, refId])
  @@index([postedAt])
  @@map("stock_ledger")
}

model StockBalance {
  id        String    @id @default(uuid())
  /// productId|batchId|godownId|rackId or -|stockType
  key       String    @unique
  branchId  String
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id])
  godownId  String
  godown    Godown    @relation(fields: [godownId], references: [id])
  rackId    String?
  rack      Rack?     @relation(fields: [rackId], references: [id])
  stockType StockType
  qtyPcs    Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@index([branchId, stockType])
  @@map("stock_balance")
}

model StockTransfer {
  id           String              @id @default(uuid())
  branchId     String
  number       String
  date         DateTime
  fromGodownId String
  fromGodown   Godown              @relation("TransferFrom", fields: [fromGodownId], references: [id])
  toGodownId   String
  toGodown     Godown              @relation("TransferTo", fields: [toGodownId], references: [id])
  status       DocStatus           @default(POSTED)
  notes        String?
  /// set for inter-branch transfers (stock sits IN_TRANSIT at the destination until received)
  toBranchId   String?
  transitState TransitState?
  vehicleNo    String?
  driverName   String?
  receivedAt   DateTime?
  receivedById String?
  lines        StockTransferLine[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@map("stock_transfer")
}

model StockTransferLine {
  id            String        @id @default(uuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id])
  fromRackId    String?
  toRackId      String?
  fromStockType StockType     @default(SALEABLE)
  toStockType   StockType     @default(SALEABLE)
  qtyPcs        Int
  receivedPcs   Int?
  damagedPcs    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?

  @@map("stock_transfer_line")
}

model StockAdjustment {
  id         String                @id @default(uuid())
  branchId   String
  number     String
  date       DateTime
  godownId   String
  godown     Godown                @relation(fields: [godownId], references: [id])
  reason     String
  status     DocStatus             @default(DRAFT)
  approvalId String?
  lines      StockAdjustmentLine[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?

  @@map("stock_adjustment")
}

model StockAdjustmentLine {
  id           String          @id @default(uuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  batchId      String
  batch        Batch           @relation(fields: [batchId], references: [id])
  rackId       String?
  stockType    StockType       @default(SALEABLE)
  /// signed: + adds stock, - removes stock
  qtyPcs       Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@map("stock_adjustment_line")
}

model BreakageEntry {
  id           String         @id @default(uuid())
  branchId     String
  number       String
  date         DateTime
  stage        BreakageStage
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  batchId      String
  batch        Batch          @relation(fields: [batchId], references: [id])
  godownId     String
  godown       Godown         @relation(fields: [godownId], references: [id])
  rackId       String?
  qtyPcs       Int
  reason       String
  photos       String[]
  approvedById String?
  status       DocStatus      @default(POSTED)
  refType      String?
  refId        String?
  claimId      String?
  claim        BreakageClaim? @relation(fields: [claimId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@map("breakage_entry")
}

// ---------------------------------------------------------------- parties

model Party {
  id                     String                  @id @default(uuid())
  type                   PartyType
  segment                Segment                 @default(RETAIL)
  name                   String
  phone                  String?
  email                  String?
  gstin                  String?
  stateCode              String                  @default("33")
  billingAddress         String?
  shippingAddress        String?
  city                   String?
  creditLimitPaise       BigInt                  @default(0)
  creditDays             Int                     @default(0)
  openingBalancePaise    BigInt                  @default(0)
  tallyLedgerGuid        String?
  tallyLedgerName        String?
  branchId               String?
  notes                  String?
  isActive               Boolean                 @default(true)
  sites                  Site[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdBy              String?
  updatedBy              String?
  deletedAt              DateTime?
  leads                  Lead[]
  quotations             Quotation[]
  salesOrders            SalesOrder[]
  invoices               Invoice[]
  deliveryChallans       DeliveryChallan[]
  salesReturns           SalesReturn[]
  creditNotes            CreditNote[]
  purchaseOrders         PurchaseOrder[]
  grns                   Grn[]
  purchaseInvoices       PurchaseInvoice[]
  debitNotes             DebitNote[]
  receipts               Receipt[]
  payments               Payment[]
  ledgerBalanceSnapshots LedgerBalanceSnapshot[]
  sampleIssues           SampleIssue[]
  breakageClaims         BreakageClaim[]

  @@index([name])
  @@index([phone])
  @@map("party")
}

model Site {
  id           String       @id @default(uuid())
  partyId      String
  party        Party        @relation(fields: [partyId], references: [id])
  name         String
  address      String?
  contactName  String?
  contactPhone String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  salesOrders  SalesOrder[]
  invoices     Invoice[]

  @@map("site")
}

model Influencer {
  id                String             @id @default(uuid())
  type              InfluencerType
  name              String
  phone             String?
  firm              String?
  commissionPct     Float              @default(0)
  pointsBalance     Int                @default(0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  influencerLedgers InfluencerLedger[]
  quotations        Quotation[]
  invoices          Invoice[]
  sampleIssues      SampleIssue[]

  @@map("influencer")
}

model InfluencerLedger {
  id           String     @id @default(uuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id])
  invoiceId    String?
  kind         String
  points       Int        @default(0)
  amountPaise  BigInt     @default(0)
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

