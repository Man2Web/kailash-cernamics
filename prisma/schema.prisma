// ==========================================
// 13. TALLYPRIME INTEGRATION MODULE
// ==========================================

model TallyConnection {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @default("Default TallyPrime")
  host            String    @default("localhost")
  port            Int       @default(9000)
  protocol        String    @default("http")
  companyName     String    @map("company_name")
  integrationMode String    @default("BRIDGE") @map("integration_mode") // BRIDGE or DIRECT
  apiKey          String    @unique @map("api_key")
  isActive        Boolean   @default(true) @map("is_active")
  lastPingAt      DateTime? @map("last_ping_at")
  lastSyncAt      DateTime? @map("last_sync_at")
  status          String    @default("CONFIGURED") // CONFIGURED, ONLINE, OFFLINE, ERROR
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  settings        TallySyncSetting[]

  @@map("tally_connections")
}

model TallySyncSetting {
  id                   String          @id @default(uuid()) @db.Uuid
  connectionId         String?         @map("connection_id") @db.Uuid
  autoSync             Boolean         @default(true) @map("auto_sync")
  syncIntervalSeconds  Int             @default(60) @map("sync_interval_seconds")
  maxRetries           Int             @default(5) @map("max_retries")
  retryDelaySeconds    Int             @default(120) @map("retry_delay_seconds")
  
  syncCustomers        Boolean         @default(true) @map("sync_customers")
  syncVendors          Boolean         @default(true) @map("sync_vendors")
  syncProducts         Boolean         @default(true) @map("sync_products")
  syncSalesInvoices    Boolean         @default(true) @map("sync_sales_invoices")
  syncPurchaseBills    Boolean         @default(true) @map("sync_purchase_bills")
  syncPayments         Boolean         @default(true) @map("sync_payments")
  syncReceipts         Boolean         @default(true) @map("sync_receipts")
  syncCreditNotes      Boolean         @default(true) @map("sync_credit_notes")
  syncDebitNotes       Boolean         @default(true) @map("sync_debit_notes")
  syncJournals         Boolean         @default(false) @map("sync_journals")

  defaultDebtorGroup   String          @default("Sundry Debtors") @map("default_debtor_group")
  defaultCreditorGroup String          @default("Sundry Creditors") @map("default_creditor_group")
  defaultSalesLedger   String          @default("Sales Account") @map("default_sales_ledger")
  defaultPurchaseLedger String         @default("Purchase Account") @map("default_purchase_ledger")
  defaultCgstLedger    String          @default("CGST") @map("default_cgst_ledger")
  defaultSgstLedger    String          @default("SGST") @map("default_sgst_ledger")
  defaultIgstLedger    String          @default("IGST") @map("default_igst_ledger")
  defaultRoundoffLedger String         @default("Round Off") @map("default_roundoff_ledger")
  defaultBankLedger    String          @default("Bank Account") @map("default_bank_ledger")
  defaultCashLedger    String          @default("Cash") @map("default_cash_ledger")

  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  connection           TallyConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("tally_sync_settings")
}

model TallyEntityMapping {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String   @map("entity_type") // CUSTOMER, VENDOR, PRODUCT, SALES_INVOICE, etc.
  entityId       String   @map("entity_id") @db.Uuid
  entityCode     String?  @map("entity_code")
  entityName     String?  @map("entity_name")
  tallyGuid      String?  @map("tally_guid")
  tallyName      String?  @map("tally_name")
  tallyVoucherNo String?  @map("tally_voucher_no")
  syncStatus     String   @default("SYNCED") @map("sync_status")
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([entityType, entityId])
  @@map("tally_entity_mappings")
}

model TallySyncQueue {
  id          String         @id @default(uuid()) @db.Uuid
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  entityCode  String?        @map("entity_code")
  entityName  String?        @map("entity_name")
  operation   String         @default("CREATE") // CREATE, UPDATE, DELETE
  direction   String         @default("ERP_TO_TALLY") @map("direction")
  status      String         @default("PENDING") // PENDING, PROCESSING, SYNCED, FAILED, RETRYING, CANCELLED
  payload     Json
  xmlRequest  String?        @map("xml_request")
  retryCount  Int            @default(0) @map("retry_count")
  maxRetries  Int            @default(5) @map("max_retries")
  lockedUntil DateTime?      @map("locked_until")
  lockedBy    String?        @map("locked_by")
  lastError   String?        @map("last_error")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  logs        TallySyncLog[]

  @@map("tally_sync_queue")
}

model TallySyncLog {
  id           String          @id @default(uuid()) @db.Uuid
  queueId      String?         @map("queue_id") @db.Uuid
  entityType   String          @map("entity_type")
  entityId     String?         @map("entity_id") @db.Uuid
  entityCode   String?         @map("entity_code")
  operation    String
  status       String          // SUCCESS, FAILED, RETRY
  requestXml   String?         @map("request_xml")
  responseXml  String?         @map("response_xml")
  responseJson Json?           @map("response_json")
  errorMessage String?         @map("error_message")
  durationMs   Int?            @map("duration_ms")
  createdAt    DateTime        @default(now()) @map("created_at")

  queue        TallySyncQueue? @relation(fields: [queueId], references: [id], onDelete: SetNull)

  @@map("tally_sync_logs")
}

model TallyFieldMapping {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @map("entity_type")
  erpField     String   @map("erp_field")
  tallyField   String   @map("tally_field")
  defaultValue String?  @map("default_value")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([entityType, erpField])
  @@map("tally_field_mappings")
}


// Failed-login log used for throttling (key = "id:<sha256 of identifier>" or "ip:<address>")
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("login_attempts")
}
