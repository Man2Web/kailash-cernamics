{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "TZ",
    "PORT",
    "APP_URL",
    "API_URL",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "JWT_*",
    "S3_*",
    "UPLOAD_DIR",
    "LOGIN_RATE_LIMIT",
    "GSP_*",
    "WHATSAPP_*",
    "SMTP_*",
    "MAIL_FROM",
    "SENTRY_DSN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
