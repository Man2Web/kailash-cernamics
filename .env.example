# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
TZ=Asia/Kolkata

# ---- Database / cache ----
# Local dev: `pnpm db:start` (embedded Postgres 16 on 5442, user erp/erp) or docker/docker-compose.yml
DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5442/kailash_erp
# Used by API e2e tests (vitest); each test run truncates it
TEST_DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5442/kailash_erp_test
# Optional in dev: without it background jobs are skipped (Tally sync does not need Redis)
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Proxies in front of the API: 1 locally (Next.js), 2 on Coolify (Traefik + Next.js)
TRUST_PROXY=1
# Secure cookies: true | false | auto (follow the request protocol)
COOKIE_SECURE=auto
# Max login attempts per IP per minute (default 5)
LOGIN_RATE_LIMIT=5
JWT_ACCESS_SECRET=generate-64-char-random
JWT_REFRESH_SECRET=generate-64-char-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Seed (hosted environments) ----
# Owner's first password (Coolify generates SERVICE_PASSWORD_OWNER); unset locally = Kailash@123
OWNER_PASSWORD=
# Load demo tiles/stock/invoices (set false before go-live)
SEED_DEMO=true
# false = create the demo role logins disabled
SEED_DEMO_USERS=true

# ---- File storage (MinIO / S3) ----
# Without S3_* the API stores uploads in UPLOAD_DIR (dev only)
UPLOAD_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=kailash-erp
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- GST (GSP sandbox first) ----
# GSP_PROVIDER: name of the GSP adapter; "mock" returns fake IRN/e-way numbers for testing
GSP_PROVIDER=
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_USERNAME=
GSP_PASSWORD=
GSP_GSTIN=

# ---- WhatsApp Business API ----
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kailash Ceramics <no-reply@kailashceramics.com>"

# ---- Off-site backups ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# ---- Monitoring ----
SENTRY_DSN=

# ---- Tally agent (per branch keys are created in Settings > Tally) ----
TALLY_AGENT_HEARTBEAT_ALERT_MINUTES=15
