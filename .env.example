# Copy to .env.local and fill in real values. NEVER commit real secrets.

# PostgreSQL connection string (Coolify internal URL in production, e.g. postgresql://user:pass@<db-uuid>:5432/postgres)
DATABASE_URL=

# Attendance QR signing secret (min 16 chars, random)
ATTENDANCE_QR_SECRET=

# Scheduled cleanup endpoint (/api/cron/cleanup) bearer secret (min 16 chars, random)
CRON_SECRET=

# One-time seeding only
ADMIN_INITIAL_PASSWORD=
SEED_ACCOUNT_PASSWORD=

# Dev / deployment hosts (comma-separated)
DEV_ALLOWED_ORIGINS=
# Public host(s) of the deployed app, host or host:port (required behind a proxy / custom domain)
SERVER_ACTION_ALLOWED_ORIGINS=

# Email (Resend) - not used by the app code yet
RESEND_API_KEY=

# App URLs
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_ATTENDANCE_URL=

# Tally
TALLY_BRIDGE_API_KEY=
