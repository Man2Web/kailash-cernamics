# API and worker image (same image; worker runs `node dist/worker`).
# Build from the repo root:  docker build -f docker/Dockerfile.api -t kailash-erp-api .
FROM node:22-alpine AS base
RUN apk add --no-cache openssl libc6-compat && corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @gc/api... --filter kailash-ceramics-erp

FROM deps AS build
COPY tsconfig.base.json ./
COPY prisma ./prisma
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN pnpm exec prisma generate \
  && pnpm --filter @gc/shared build \
  && pnpm --filter @gc/api build

FROM base AS run
ENV NODE_ENV=production TZ=Asia/Kolkata PORT=4000
COPY --from=build /app /app
# writable upload folder for the non-root user (a new named volume copies this ownership)
RUN mkdir -p /data/uploads && chown -R node:node /data
WORKDIR /app/apps/api
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:4000/api/health || exit 1
CMD ["node", "dist/main"]
